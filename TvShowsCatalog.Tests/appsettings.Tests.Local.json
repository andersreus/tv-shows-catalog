{
  "$schema": "./appsettings-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      "_comment": "On my windows machine I used \"LocalDB\" which is a SQL Server and not supported on my current mac - so I swapped \"LocalDB\" with \"SQLite\" instead",
      "DatabaseType": "SQLite",
      "PrepareThreadCount": 4,
      "SchemaDatabaseCount": 4,
      "EmptyDatabasesCount": 2,
      "SQLServerMasterConnectionString": ""
    }
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "AllowedUploadedFileExtensions": [ "jpg", "png", "gif", "svg" ]
      }
    }
  }
}